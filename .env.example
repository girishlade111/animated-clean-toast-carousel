# =============================================================================
# Environment variables — animated-clean-toast-carousel
# =============================================================================
# This project currently needs ZERO environment variables to run.
# Everything below is commented out and documents the *conventions* you
# should follow when you add an integration that needs secrets or config.
#
# Next.js loads env files in this order (later overrides earlier):
#   1. .env.development.local / .env.production.local / .env.test.local
#   2. .env.local            (never commit this — it holds real secrets)
#   3. .env.development / .env.production / .env.test
#   4. .env
#
# RULE: only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Anything without the prefix stays server-side only.
# =============================================================================

# --- Example: public, browser-safe config ------------------------------------
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Example: server-only secret (API route / server component only) ---------
# SOME_API_KEY=sk-...

# --- Example: Vercel Analytics is dependency-installed but not wired ---------
# (no env var needed — just render <Analytics /> in app/layout.tsx)

# --- Example: if you add a database / auth provider later --------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# NEXTAUTH_URL=http://localhost:3000
